# Copy to .env for local development. On Render these are service environment variables.
DB_PASSWORD=          # password of the Postgres role xiao_api
JWT_SECRET=           # long random string, signs login tokens
DEVICE_KEY=           # shared with the board (CloudAPIDashboard/secrets.h)
